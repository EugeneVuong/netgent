{
  "specification": "1. Go to 'https://www.google.com'.\n2. Type <secret>google_query</secret> into the Google search box and press Enter.\n3. On the results page, click the first result link that points to youtube.com.\n4. On YouTube, type <secret>youtube_query</secret> into the YouTube search box and press Enter.\n5. Click the first video in the search results.\n6. Keep the video playing for <secret>watch_seconds</secret> seconds.",
  "states": [
    {
      "checks": [
        {
          "type": "always_true",
          "params": {}
        }
      ],
      "actions": [
        {
          "type": "go_to_url",
          "params": {
            "url": "https://www.google.com",
            "new_tab": false
          }
        },
        {
          "type": "input_text",
          "params": {
            "selector": "textarea[name=\"q\"]",
            "text": "{{google_query}}"
          }
        },
        {
          "type": "send_keys",
          "params": {
            "keys": "Enter"
          }
        },
        {
          "type": "wait",
          "params": {
            "seconds": "5"
          }
        },
        {
          "type": "click_element",
          "params": {
            "selector": "#search h3",
            "timeout_ms": 10000
          }
        },
        {
          "type": "input_text",
          "params": {
            "selector": "input[name=\"search_query\"]",
            "text": "{{youtube_query}}"
          }
        },
        {
          "type": "send_keys",
          "params": {
            "keys": "Enter"
          }
        },
        {
          "type": "wait",
          "params": {
            "seconds": "5"
          }
        },
        {
          "type": "click_element",
          "params": {
            "selector": "ytd-video-renderer a#video-title",
            "timeout_ms": 10000
          }
        },
        {
          "type": "wait",
          "params": {
            "seconds": "{{watch_seconds}}"
          }
        }
      ],
      "end_state": "Workflow Completed",
      "executed": []
    }
  ],
  "parameters": [
    "google_query",
    "youtube_query",
    "watch_seconds"
  ]
}
