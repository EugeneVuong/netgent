{
  "specification": "1. Go to 'https://duckduckgo.com'.\n    2. Type <secret>search_query</secret> into the DuckDuckGo search box and press Enter to search.\n    3. On the results page, click the first result, which links to youtube.com (do not open it in a new tab).\n    4. Once on YouTube, wait a few seconds for the page to finish loading.\n    5. Type <secret>youtube_query</secret> into the YouTube search box and press Enter.\n    6. In the search results, click the first regular video (not an ad, Short, channel, or playlist).\n    7. The video starts playing automatically once the watch page loads. Do not click the player or the play button, since that would pause it.\n    8. Keep the video playing for <secret>watch_seconds</secret> seconds, then stop.",
  "states": [
    {
      "checks": [
        {
          "type": "always_true",
          "params": {}
        }
      ],
      "actions": [
        {
          "type": "go_to_url",
          "params": {
            "url": "https://duckduckgo.com",
            "new_tab": false
          }
        },
        {
          "type": "input_text",
          "params": {
            "selector": "textarea[id=\"searchbox_input\"][name=\"q\"]",
            "text": "{{search_query}}"
          }
        },
        {
          "type": "send_keys",
          "params": {
            "keys": "Enter"
          }
        },
        {
          "type": "click_element",
          "params": {
            "selector": "a.eVNpHGjtxRBq_gLOfGDr.LQNqh2U1kzYxREs65IJu[data-testid=\"result-title-a\"]"
          }
        },
        {
          "type": "wait",
          "params": {
            "seconds": 2
          }
        },
        {
          "type": "input_text",
          "params": {
            "selector": "input.yt-searchbox-input.title[name=\"search_query\"][placeholder=\"Search\"]",
            "text": "{{youtube_query}}"
          }
        },
        {
          "type": "send_keys",
          "params": {
            "keys": "Enter"
          }
        },
        {
          "type": "wait",
          "params": {
            "seconds": 3
          }
        },
        {
          "type": "click_element",
          "params": {
            "selector": "button[aria-label=\"Search\"]"
          }
        },
        {
          "type": "click_element",
          "params": {
            "selector": "a.yt-simple-endpoint.style-scope[id=\"video-title\"]"
          }
        },
        {
          "type": "wait",
          "params": {
            "seconds": "{{watch_seconds}}"
          }
        },
        {
          "type": "assert_media_playing",
          "params": {
            "selector": "video",
            "min_seconds": 5
          }
        }
      ],
      "end_state": "Workflow Completed",
      "executed": []
    }
  ],
  "parameters": [
    "search_query",
    "youtube_query",
    "watch_seconds"
  ]
}
